# Copy to .env.local and fill in real values. Do not commit .env.local.
# The app does not read SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# NEXT_PUBLIC_WHOP_COMPANY_ID, or NEXT_PUBLIC_WHOP_AGENT_USER_ID.

# Postgres connection used by Drizzle (lib/supabase/db-server.ts, drizzle.config.ts).
# Prefer the Supavisor session pooler: host aws-1-eu-west-1.pooler.supabase.com,
# port 5432, user postgres.<project-ref>, database postgres.
# The direct host db.<project-ref>.supabase.co is IPv6-only and was unreachable here.
POSTGRES_URL=
# Fallback when POSTGRES_URL is unset. Same session pooler URL is fine.
POSTGRES_URL_NON_POOLING=

# Whop app API key. Server only.
WHOP_API_KEY=
# Whop app id. Safe to expose to the browser.
NEXT_PUBLIC_WHOP_APP_ID=
# Standard Webhooks secret for POST /api/webhook.
WHOP_WEBHOOK_SECRET=

# Google Gemini key for funnel and theme generation (@google/genai).
GEMINI_API_KEY=

# Optional fallback experience id used when a request does not include one.
# lib/actions/credit-actions.ts, lib/hooks/useCredits.ts,
# app/api/generate-funnel/route.ts, app/api/validate-credits/route.ts
NEXT_PUBLIC_WHOP_EXPERIENCE_ID=

# Optional Whop plan ids for the three credit packs (lib/types/credit.ts).
NEXT_PUBLIC_CREDIT_PACK_STARTER_PLAN_ID=
NEXT_PUBLIC_CREDIT_PACK_POPULAR_PLAN_ID=
NEXT_PUBLIC_CREDIT_PACK_PRO_PLAN_ID=

# Optional bearer secret for the daily-rollover and sync-reviews cron routes.
CRON_SECRET=

# Set by the platform. Do not set these by hand on Vercel.
# NODE_ENV
# VERCEL
# VERCEL_URL
# VERCEL_ENV
